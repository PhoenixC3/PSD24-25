<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.peerapp.LoginController" prefHeight="200.0" prefWidth="400.0">
    <TextField fx:id="usernameField" layoutX="100.0" layoutY="40.0" prefWidth="200.0" promptText="Enter User ID"/>
    <PasswordField fx:id="passwordField" layoutX="100.0" layoutY="80.0" prefWidth="200.0" promptText="Enter Password"/>
    <Button fx:id="loginButton" layoutX="100.0" layoutY="130.0" text="Login"/>
    <Button fx:id="registerButton" layoutX="200.0" layoutY="130.0" text="Register"/>
    <Text fx:id="statusText" layoutX="100.0" layoutY="170.0"/>
</AnchorPane>
