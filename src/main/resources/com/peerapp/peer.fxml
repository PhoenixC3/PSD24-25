<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.peerapp.PeerController"
      spacing="10"
      style="-fx-background-color: white;">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <TextField fx:id="recipientField" 
               promptText="Enter recipient ID"
               maxWidth="200"/>

    <ScrollPane fx:id="messagesArea" 
                VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent;">
        <VBox fx:id="messagesVBox"/>
    </ScrollPane>

    <HBox spacing="10">
        <TextField fx:id="messageField" 
                  promptText="Enter message"
                  HBox.hgrow="ALWAYS"/>
        <Button fx:id="sendButton" 
                text="Send"
                style="-fx-background-color: #0084FF; -fx-text-fill: white;"/>
    </HBox>

</VBox>