<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.peerapp.PeerController" prefHeight="400.0" prefWidth="600.0">
    <TextField fx:id="recipientField" layoutX="20.0" layoutY="20.0" prefWidth="400.0" promptText="Enter recipient ID"/>
    <Button fx:id="sendButton" layoutX="450.0" layoutY="20.0" text="Send"/>
    <TextArea fx:id="messagesArea" layoutX="20.0" layoutY="70.0" prefHeight="300.0" prefWidth="560.0" editable="false" wrapText="true" promptText="Messages will appear here..."/>
</AnchorPane>
