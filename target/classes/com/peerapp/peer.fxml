<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.peerapp.PeerController"
      spacing="10">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
    
    <SplitPane VBox.vgrow="ALWAYS" dividerPositions="0.3">
        
        <!-- Left side: Contacts/Chat History -->
        <VBox spacing="10">
            <!-- Direct Messages Section -->
            <Label text="Direct Messages" style="-fx-font-weight: bold; -fx-background-color: white; -fx-padding: 5; -fx-background-radius: 10;"/>
            <TextField fx:id="searchField" layoutX="50" layoutY="10" prefWidth="200" promptText="Search contacts..."/>
            <Button fx:id="searchButton" text="Search" layoutX="50" layoutY="20"/>
            <Button fx:id="refreshButton" text="Refresh" layoutX="50" layoutY="20"/>
            <Button fx:id="searchKeywordButton" text="Search Keyword" layoutX="50" layoutY="20"/>
            <HBox spacing="5" alignment="CENTER_LEFT">
                <ProgressIndicator fx:id="searchProgress" 
                        visible="false" 
                        maxHeight="20" 
                        maxWidth="20"/>
                <Label fx:id="searchStatusLabel" 
                        visible="false" 
                        wrapText="true"/>
            </HBox>
            <ListView fx:id="searchResultsListView" prefHeight="500" VBox.vgrow="ALWAYS"/>
            <Label text="Available Peers:" style="-fx-font-weight: bold; -fx-background-color: white; -fx-padding: 5; -fx-background-radius: 10;"/>
            <ListView fx:id="contactsListView" prefHeight="500" VBox.vgrow="ALWAYS"/>

            <Region styleClass="spacer" minHeight="20" />
            
            <!-- Group Management Section -->
            <Label text="Create Group:" style="-fx-font-weight: bold; -fx-background-color: white; -fx-padding: 5; -fx-background-radius: 10;"/>
            <TextField fx:id="topicField" promptText="Group Topic"/>
            <Button fx:id="createGroupButton" text="Create Group"/>
            <Label fx:id="groupStatusLabel" 
                        visible="false" 
                        wrapText="true"/>
            <Label text="Groups you are in:" style="-fx-font-weight: bold; -fx-background-color: white; -fx-padding: 5; -fx-background-radius: 10;"/>
            <ListView fx:id="groupsListView" prefHeight="500" VBox.vgrow="ALWAYS"/>

            <Region styleClass="spacer" minHeight="20" />

            <!-- Available groups -->
            <Label text="Groups you can join:" style="-fx-font-weight: bold; -fx-background-color: white; -fx-padding: 5; -fx-background-radius: 10;"/>
            <ListView fx:id="additionalGroupsListView" prefHeight="300" VBox.vgrow="ALWAYS"/>
            <Button fx:id="addMemberButton" text="Join Group" visible="false"/>
            <Button fx:id="refreshButtonGroups" text="Refresh" layoutX="50" layoutY="20"/>
        </VBox>
        
        <!-- Right side: Chat Area -->
        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 5; -fx-background-radius: 10;">

            <Label text="Chat Area" style="-fx-font-weight: bold;"/>

            <Label fx:id="currentUserIdLabel" layoutX="50" layoutY="50" text="No conversation selected"/>
    
            <ScrollPane fx:id="messagesArea" 
                    VBox.vgrow="ALWAYS"
                    style="-fx-background-color: transparent;">
                <VBox fx:id="messagesVBox"/>
            </ScrollPane>
    
            <HBox spacing="10">
                <TextField fx:id="messageField" 
                      promptText="Enter message"
                      HBox.hgrow="ALWAYS"/>
                <Button fx:id="sendButton" layoutX="350" layoutY="350"
                    text="Send"
                    style="-fx-background-color: #0084FF; -fx-text-fill: white;"/>
            </HBox>
        </VBox>
        
    </SplitPane>
</VBox>